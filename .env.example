# ──────────────────────────────────────────────────────────────
# EmailJS — sends contact-form messages straight to your inbox.
# Free tier: 200 emails/month, no credit card, no backend.
#
# STEP-BY-STEP
# 1. Create a free account → https://www.emailjs.com
# 2. "Email Services" → Add New Service → Gmail
#    → connect imjohndominic08@gmail.com → copy the SERVICE ID below
# 3. "Email Templates" → Create New Template:
#      Subject:  Portfolio message from {{from_name}}
#      Content:  {{message}}
#                (set "Reply To" to {{reply_to}})
#    → save → copy the TEMPLATE ID below
# 4. "Account" → General → copy your PUBLIC KEY below
# 5. Paste all three into .env (this file) and restart `npm run dev`
# ──────────────────────────────────────────────────────────────

VITE_EMAILJS_SERVICE_ID="your-service-id"
VITE_EMAILJS_TEMPLATE_ID="your-template-id"
VITE_EMAILJS_PUBLIC_KEY="your-public-key"
